# Copy to `.env` and adjust. Do not commit real secrets.
# See docs/deployment-guide.md and docs/development-guide.md.

# --- Application ---
# Required for production; compose defaults to a dev placeholder if unset.
EXAMINAI_SECRET_KEY=

# Database DSN (SQLAlchemy). Compose sets this for the `app` service; override locally if needed.
# Example (host Postgres): postgresql+psycopg://examinai:examinai@localhost:5432/examinai
EXAMINAI_DATABASE_URL=postgresql+psycopg://examinai:examinai@localhost:5432/examinai

# Docker / production-style Postgres: run Liquibase before the app (see README-Python.md).
# EXAMINAI_USE_LIQUIBASE=1

# First administrator (only if no user has the administrator role yet). Never commit real values.
# EXAMINAI_ADMIN_INITIAL_PASSWORD=
# EXAMINAI_ADMIN_EMAIL=admin@examinai.local

# Optional: seed demo user on startup (development only).
# EXAMINAI_BOOTSTRAP_DEMO=false

# --- Ollama ---
# Inside Docker Compose use the service hostname, e.g. http://llm:11434 (not 127.0.0.1).
OLLAMA_BASE_URL=http://llm:11434
OLLAMA_MODEL=llama3.2
# OLLAMA_TIMEOUT_SECONDS=120
# OLLAMA_MAX_RETRIES=2

# --- Git provider (mentor fetch) ---
# GIT_PROVIDER_BASE_URL=https://api.github.com
# GIT_PROVIDER_TOKEN=
# GIT_PROVIDER_TIMEOUT_SECONDS=45
